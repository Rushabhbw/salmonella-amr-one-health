# Snakemake workflow: raw NCBI downloads -> curated metadata -> feature table.
#
# Run from the repository root, inside WSL / Linux, with the environment active:
#     conda activate salmonella-amr-tools
#     snakemake --cores 1            # build everything
#     snakemake --cores 1 -n         # dry run: show what would be done
#     snakemake --cores 1 concordance_report   # after the AMRFinderPlus runs (see README): compare our run with NCBI
#
# Steps that need the internet and many minutes (downloading genomes, running AMRFinderPlus) are NOT part of
# the default target. They are run with workflow/scripts/run_amrfinder_subset.sh (see README).
import os
import pandas as pd

configfile: "config/config.yaml"

RAW_DIR = config["raw_dir"]
MANIFEST = config["manifest"]
RAW_FILES = [f"{RAW_DIR}/{name}" for name in pd.read_csv(MANIFEST, sep="\t")["file"]]


# config/element_classes.tsv is reference data made once by workflow/scripts/05_map_elements_to_classes.py from the
# AMRFinderPlus Reference Gene Catalog (see README). The baseline is only part of the default target when it exists.
ELEMENT_CLASSES = "config/element_classes.tsv"
TARGETS = [
    "docs/data_provenance.md",
    "reports/curation_report.md",
    "data/processed/features_presence.tsv",
    "reports/feature_report.md",
    "data/processed/subset_300.tsv",
    "data/processed/splits.tsv",
    "reports/splits_report.md",
]
if os.path.exists(ELEMENT_CLASSES):
    TARGETS += ["data/processed/baseline_predictions.tsv", "reports/baseline_report.md",
                "data/processed/ml_metrics.tsv", "reports/ml_report.md"]


rule all:
    input:
        TARGETS,


rule provenance:
    """Write the data log (row counts, columns, checksums). Fails if a count or column set is wrong."""
    input:
        manifest=MANIFEST,
        raw=RAW_FILES,
    output:
        "docs/data_provenance.md",
    shell:
        "python workflow/scripts/00_log_data_provenance.py --raw-dir {RAW_DIR} --manifest {input.manifest} --out {output}"


rule curate:
    """Merge the raw tables, remove duplicates and unusable records, build labels and metadata."""
    input:
        raw=RAW_FILES,
        provenance="docs/data_provenance.md",   # curation only runs after the raw data passed the checks
    output:
        metadata="data/processed/metadata_curated.tsv",
        mapping="data/processed/source_mapping.tsv",
        removed="data/interim/removed_isolates.tsv",
        report="reports/curation_report.md",
    shell:
        "python workflow/scripts/01_curate_metadata.py --raw-dir {RAW_DIR} "
        "--processed-dir data/processed --interim-dir data/interim --report {output.report}"


rule subset:
    """Choose the 300-isolate subset (seed 42) used for the local AMRFinderPlus check."""
    input:
        "data/processed/metadata_curated.tsv",
    output:
        table="data/processed/subset_300.tsv",
        accessions="data/processed/subset_300_accessions.txt",
        pilot="data/processed/subset_pilot_accessions.txt",
    shell:
        "python workflow/scripts/02_select_subset.py --metadata {input} --out-dir data/processed"


rule features:
    """Build the 0/1 resistance-element table from NCBI's stored AMRFinderPlus results."""
    input:
        "data/processed/metadata_curated.tsv",
    output:
        presence="data/processed/features_presence.tsv",
        uncertain="data/processed/features_uncertain.tsv",
        dictionary="data/processed/feature_dictionary.tsv",
        report="reports/feature_report.md",
    shell:
        "python workflow/scripts/04_build_features.py --metadata {input} --out-dir data/processed --report {output.report}"


rule splits:
    """Define the evaluation splits (grouped 5-fold, clean human transfer test, time split) once for every model."""
    input:
        "data/processed/metadata_curated.tsv",
    output:
        table="data/processed/splits.tsv",
        report="reports/splits_report.md",
    shell:
        "python workflow/scripts/07_make_splits.py --metadata {input} --out {output.table} --report {output.report}"


rule baseline:
    """Rule-based baseline: resistant if the isolate carries an element linked to the antibiotic."""
    input:
        metadata="data/processed/metadata_curated.tsv",
        features="data/processed/features_presence.tsv",
        mapping=ELEMENT_CLASSES,
    output:
        predictions="data/processed/baseline_predictions.tsv",
        report="reports/baseline_report.md",
    shell:
        "python workflow/scripts/06_baseline_rules.py --metadata {input.metadata} --features {input.features} "
        "--mapping {input.mapping} --out {output.predictions} --report {output.report}"


rule models:
    """Machine-learning models versus the baseline on the fixed splits (takes several minutes)."""
    input:
        metadata="data/processed/metadata_curated.tsv",
        features="data/processed/features_presence.tsv",
        uncertain="data/processed/features_uncertain.tsv",
        splits="data/processed/splits.tsv",
        baseline="data/processed/baseline_predictions.tsv",
        mapping=ELEMENT_CLASSES,
    output:
        metrics="data/processed/ml_metrics.tsv",
        importance="data/processed/ml_feature_importance.tsv",
        predictions="data/processed/ml_predictions.tsv.gz",
        report="reports/ml_report.md",
    threads: 4
    shell:
        "N_JOBS={threads} python workflow/scripts/08_train_evaluate_models.py --metadata {input.metadata} --features {input.features} "
        "--uncertain {input.uncertain} --splits {input.splits} --baseline {input.baseline} --mapping {input.mapping} "
        "--out-dir data/processed --report {output.report}"


rule concordance_report:
    """On demand: compare our local AMRFinderPlus results with NCBI's stored results."""
    input:
        metadata="data/processed/metadata_curated.tsv",
        versions="data/interim/amrfinder_local/versions.txt",   # exists only after run_amrfinder_subset.sh has run
    output:
        report="reports/amrfinder_concordance.md",
        table="data/processed/amrfinder_concordance_per_isolate.tsv",
    shell:
        "python workflow/scripts/03_compare_amrfinder.py --amr-dir data/interim/amrfinder_local "
        "--metadata {input.metadata} --report {output.report} --table {output.table}"
